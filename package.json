{
  "name": "xrift-avatar-pose-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Render-time avatar pose control experiments for XRift rides",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./xrift": {
      "types": "./src/adapters/xrift.d.mts",
      "import": "./src/adapters/xrift.mjs"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5228 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "replay:n02": "node scripts/replay-n02-profile.mjs",
    "replay:patterns": "node scripts/replay-pose-patterns.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "verify": "npm test && npm run build"
  },
  "peerDependencies": {
    "three": ">=0.183.1 <0.184.0"
  },
  "devDependencies": {
    "three": "0.183.1",
    "@types/three": "0.183.1",
    "@pixiv/three-vrm": "3.5.5",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
